{
  "name": "financial-product-nav",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build ./src/index.html --outdir=dist --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "start": "NODE_ENV=production bun src/index.ts"
  },
  "dependencies": {
    "big.js": "^7.0.1",
    "dayjs": "^1.11.19",
    "preact": "^10.27.2"
  },
  "devDependencies": {
    "@types/big.js": "^6.2.2",
    "@types/bun": "latest"
  }
}
